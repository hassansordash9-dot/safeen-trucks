  "legal": {
    "about": {
      "p1": "سفين تراكس سوق لبيع وشراء الشاحنات وقطع غيارها في إقليم كردستان والعراق. يبحث المشترون ويقارنون ويتواصلون مع البائع مباشرة.",
      "p2": "أبقينا المنصة بسيطة عن قصد: إعلانات واضحة، صور حقيقية، أسعار صادقة، وتواصل مباشر عبر واتساب أو الهاتف.",
      "p3": "تتم مراجعة كل إعلان قبل نشره، ويمكن للمعارض طلب التوثيق ليعرف المشتري مع من يتعامل."
    },
    "help": {
      "sellTitle": "كيف تبيع",
      "sellBody": "أنشئ حساباً، اضغط بيع، اختر شاحنة أو قطعة، أضف الصور والتفاصيل ثم انشر. يراجع فريقنا الإعلانات الجديدة، غالباً خلال يوم.",
      "buyTitle": "كيف تشتري",
      "buyBody": "ابحث أو استخدم الفلاتر، افتح الإعلان، وتواصل مع البائع عبر واتساب أو الهاتف. سفين تراكس لا يتعامل بالمدفوعات — تتفق على السعر والتسليم مع البائع مباشرة.",
      "safetyTitle": "حافظ على سلامتك",
      "safetyBody": "افحص الشاحنة قبل الدفع. لا ترسل عربوناً لشخص لم تقابله. أبلغ عن أي إعلان يبدو وهمياً أو مضللاً."
    },
    "contact": {
      "p1": "أسئلة أو مشكلة في إعلان أو استفسار للمعارض — تواصل معنا وسنرد في أقرب وقت.",
      "email": "البريد الإلكتروني",
      "hours": "نرد خلال ساعات العمل، من السبت إلى الخميس."
    },
    "privacy": {
      "p1": "نجمع فقط ما يحتاجه السوق: بيانات حسابك، والإعلانات التي تنشرها، ورقم التواصل الذي يستخدمه المشترون للوصول إليك.",
      "p2": "يظهر رقم هاتفك وواتسابك على إعلاناتك لأن هذه هي وسيلة التواصل. بريدك الإلكتروني لا يُعرض للعامة أبداً.",
      "p3": "نسجّل مؤشرات استخدام مجهولة مثل مشاهدات الإعلان وعدد الضغطات على أزرار واتساب والاتصال، ليعرف البائع أداء إعلاناته.",
      "p4": "لا نبيع بياناتك الشخصية. يمكنك طلب حذف حسابك وإعلاناتك في أي وقت."
    },
    "terms": {
      "p1": "باستخدامك سفين تراكس توافق على نشر معلومات دقيقة عما تبيعه، بما في ذلك الحالة والممشى والسعر.",
      "p2": "سفين تراكس منصة إعلانات. لسنا طرفاً في أي عملية بيع، ولا نحتفظ بالأموال، ولا نضمن حالة أي شاحنة أو قطعة.",
      "p3": "يحق لنا إيقاف أو رفض أو إزالة الإعلانات المضللة أو المكررة أو غير القانونية أو المبلّغ عنها، وتعليق الحسابات المخالفة.",
      "p4": "شارات التوثيق تعكس فحوصاً أجريناها في وقت معين، وهي ليست ضماناً لأي صفقة."
    }
  }
}
